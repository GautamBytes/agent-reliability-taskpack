+            pos = candidate.end()
+            if not preamble and pos == len(data) and not self.complete:
+                return None, start
+
+            if len(data) - pos < len(self._delimiter):
+                if self._delimiter.startswith(data[pos:]) and not self.complete:
+                    return None, start
+                continue
