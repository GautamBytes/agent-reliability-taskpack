+def _write_all(write: t.Callable[[bytes], t.Any], data: bytes) -> None:
+    offset = 0
+    while offset < len(data):
+        size = write(data[offset:])
+        if (
+            isinstance(size, bool)
+            or not isinstance(size, int)
+            or size <= 0
+            or size > len(data) - offset
+        ):
+            raise OSError("File stream write returned an invalid byte count")
+        offset += size
