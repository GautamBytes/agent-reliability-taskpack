+def _write_all(stream: t.IO[bytes], data: bytes) -> None:
+    offset = 0
+    while offset < len(data):
+        remaining = data[offset:]
+        count = stream.write(remaining)
+        if (
+            not isinstance(count, int)
+            or isinstance(count, bool)
+            or count <= 0
+            or count > len(remaining)
+        ):
+            raise OSError("File stream write returned an invalid byte count")
+        offset += count
+
