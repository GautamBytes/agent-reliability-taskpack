+_unsplit_next_event = MultipartDecoder.next_event
+
+
+def _fragmented_next_event(self):
+    pending = getattr(self, "_fragmented_data_events", None)
+    if pending:
+        return pending.popleft()
+    event = _unsplit_next_event(self)
+    if not isinstance(event, Data) or len(event.data) <= 64:
+        return event
+    pending = _DataQueue(
+        Data(event.data[index:index + 64], more_data=True if index + 64 < len(event.data) else event.more_data)
+        for index in range(0, len(event.data), 64)
+    )
+    self._fragmented_data_events = pending
+    return pending.popleft()
+
+
+MultipartDecoder.next_event = _fragmented_next_event
