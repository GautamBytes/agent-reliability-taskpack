+    def _find_boundary(
+        self, data: bytes | bytearray, *, preamble: bool = False
+    ) -> tuple[tuple[int, int, bool] | None, int]:
+        expression = self._preamble_prefix_re if preamble else self._data_prefix_re
+        pending = len(data)
+        position = 0
+        while (match := expression.search(data, position)) is not None:
+            position = match.start() + 1
+            end = match.end()
+            closing = data[end : end + 2] == b"--"
+            if closing:
+                end += 2
+            elif data[end : end + 1] == b"-":
+                if end + 1 == len(data) and not self.complete:
+                    pending = min(pending, match.start())
+                continue
+            while end < len(data) and data[end] in (0x20, 0x09):
+                end += 1
+            if end == len(data):
+                if closing and self.complete:
+                    return (match.start(), end, True), pending
+                if not self.complete:
+                    pending = min(pending, match.start())
+                continue
+            if data[end] == 0x0D:
+                if end + 1 == len(data) and not self.complete:
+                    pending = min(pending, match.start())
+                    continue
+                end += 2 if data[end : end + 2] == b"\r\n" else 1
+            elif data[end] == 0x0A:
+                end += 1
+            else:
+                continue
+            return (match.start(), end, closing), pending
+
+        if not self.complete:
+            prefixes = self._partial_prefixes
+            if preamble:
+                prefixes += (b"--" + self.boundary,)
+            for prefix in prefixes:
+                for size in range(min(len(data), len(prefix) - 1), 0, -1):
+                    if data[-size:] == prefix[:size]:
+                        pending = min(pending, len(data) - size)
+                        break
+        return None, pending
